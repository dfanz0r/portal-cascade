{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "strict": true,
        "outDir": "dist",
        "types": ["./types"],
        "baseUrl": ".",
        "paths": {
            "portal-cascade": ["./src"],
            "portal-cascade/*": ["./src/*"]
        },
        "rootDirs": ["./src", "./types"]
    },
    "include": ["src/**/*", "types/**/*", "scripts/**/*", "mods/**/*"]
}
